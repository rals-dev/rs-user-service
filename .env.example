TIMEZONE=Asia/Jakarta
CONSUL_HTTP_URL=
CONSUL_HTTP_PATH=
CONSUL_HTTP_TOKEN=
CONSUL_WATCH_INTERVAL_SECONDS=60

# Admin seeder: leave all four unset to skip seeding (safe default, including
# in production). To seed a development admin user, set all four explicitly -
# there is no built-in default credential. ADMIN_PASSWORD must be at least 8
# characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE_NUMBER=